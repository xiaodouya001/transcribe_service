# STT Provider (speech-to-text service)
STT_PROVIDER_URL=http://localhost:8765/sse
MODE=sse
SSE_READ_TIMEOUT=
WS_PING_INTERVAL=20.0
WS_PING_TIMEOUT=20.0

# Redis
REDIS_URL=redis://localhost:6379/0
DEDUP_KEY_PARTS=session_id,processing_id,seq_no
DEDUP_TTL_SECONDS=60

# Redis Buffer
REDIS_BUFFER_ENABLED=true
REDIS_BUFFER_STREAM=transcription:ingest:buffer
REDIS_BUFFER_CONSUMER_GROUP=transcription:ingest:consumer
REDIS_BUFFER_MAXLEN=10000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transcription_topic
KAFKA_COMPRESSION_TYPE=none
KAFKA_SEND_TIMEOUT_SEC=10

# 长连接与重连
RECONNECT_ENABLED=true
RECONNECT_MAX_RETRIES=0
RECONNECT_INITIAL_DELAY=1.0
RECONNECT_MAX_DELAY=60.0
RECONNECT_BACKOFF_FACTOR=2.0

# 其它
CLEANER_MODE=default
STOP_TIMEOUT=120
LOG_LEVEL=INFO
LOG_FORMAT=auto
