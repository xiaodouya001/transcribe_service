# Fanolab ASR 连接
FANOLAB_URL=http://localhost:8765/sse
MODE=sse

# Redis (生产环境)
REDIS_URL=redis://localhost:6379/0

# Kafka (生产环境)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=asr_realtime_text

# Demo 模式: true 使用 MemoryDedup + EchoProducer，无需 Redis/Kafka
DEMO_MODE=true

# 优雅停机超时 (秒)
STOP_TIMEOUT=120
