# Transcribe Service 环境变量示例
# 复制为 .env 并修改: cp .env.example .env

# =============================================================================
# Redis
# =============================================================================
# Redis 连接地址
REDIS_URL=redis://localhost:6379/0
# Redis 连接池大小（高并发时调大）
REDIS_MAX_CONNECTIONS=100
# 去重 Key 组成（逗号分隔：session_id, processing_id, seq_no, created_at）
DEDUP_KEY_PARTS=session_id,processing_id,seq_no
# 去重 Key 过期时间（秒）
DEDUP_TTL_SECONDS=60

# =============================================================================
# Kafka
# =============================================================================
# Kafka 集群地址
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Topic 名称
KAFKA_TOPIC=transcription_topic
# 新建 Topic 时的分区数（已有 Topic 不受影响，建议 6–12 以提升写入并行度）
KAFKA_TOPIC_NUM_PARTITIONS=6
# 压缩类型：none、gzip、snappy、lz4（默认 lz4 降低网络与存储）
KAFKA_COMPRESSION_TYPE=lz4
# 发送超时（秒），Kafka 不可用时超时并输出错误日志
KAFKA_SEND_TIMEOUT_SEC=10

# =============================================================================
# Transcribe Service（Webhook 模式）
# =============================================================================
# 单 Pod 最大会话数
TRANSCRIBE_SERVICE_MAX_SESSIONS_PER_POD=100
# 协议：sse 或 websocket（Webhook 收到 ws_url/sse_url 后按此选择）
TRANSCRIBE_SERVICE_PROTOCOL=sse
# 是否允许 ws_url/sse_url 指向 127.0.0.1；仅 Demo 可设为 true
TRANSCRIBE_SERVICE_SSRF_ALLOW_LOCALHOST=false

# =============================================================================
# 长连接与重连
# =============================================================================
# 是否启用自动重连
RECONNECT_ENABLED=true
# 最大重试次数，0=无限
RECONNECT_MAX_RETRIES=0
# 初始退避延迟（秒）
RECONNECT_INITIAL_DELAY=1.0
# 最大退避延迟（秒）
RECONNECT_MAX_DELAY=60.0
# 退避因子
RECONNECT_BACKOFF_FACTOR=2.0
# SSE 读超时（秒）；none 或省略=无限制；或设为秒数如 60
# SSE_READ_TIMEOUT=none
# WebSocket ping 间隔（秒）
WS_PING_INTERVAL=20.0
# WebSocket pong 超时（秒）
WS_PING_TIMEOUT=20.0

# =============================================================================
# 其它
# =============================================================================
# 数据清洗模式：default（raw+cleaned）、identity（透传）
CLEANER_MODE=default
# 优雅停机超时（秒）
STOP_TIMEOUT=120
# 日志级别：DEBUG、INFO、WARNING、ERROR
LOG_LEVEL=INFO
# 日志格式：json、console、auto（非 TTY 自动用 json）
LOG_FORMAT=auto
