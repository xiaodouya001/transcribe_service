# Realtime Transcribe Service 环境变量示例
# 复制为 .env 并修改: cp .env.example .env

# =============================================================================
# Runtime / Environment
# =============================================================================
# 运行模式：local=允许 Redis/Kafka 地址缺省回退到 localhost；deployed=必须显式提供依赖地址
APP_ENV=local

# =============================================================================
# Redis（状态机）
# =============================================================================
# Redis 连接地址
REDIS_URL=redis://127.0.0.1:6379/0
# Redis 连接池大小（高并发时调大）
# 每条 WS 消息需 2 次 Redis 往返（prepare + commit），await 期间持有连接。
# 400 并发平衡档建议：1200（覆盖连接占用与抖动）
# 1000 并发容量档可提升到 2000+
# 勿超过 Redis maxclients（默认 10000）
REDIS_MAX_CONNECTIONS=1200
# 活跃会话 TTL（秒），每次写入自动续期
REDIS_ACTIVE_TTL_SEC=3600
# SESSION_COMPLETE 后的残留 TTL（秒），兜住迟到包
REDIS_FINAL_TTL_SEC=30
# conversation 发送连接 owner key TTL（秒）
REDIS_OWNERSHIP_GUARD_TTL_SEC=30
# Redis Sequence State Machine key 前缀
REDIS_SEQUENCE_STATE_KEY_PREFIX=realtime-transcribe-service:expect-transcript-seq-num
# Redis Ownership Guard key 前缀
REDIS_OWNERSHIP_GUARD_KEY_PREFIX=realtime-transcribe-service:conversation-owner

# =============================================================================
# Kafka
# =============================================================================
# 组合说明（与 docs/config/configuration.md「Kafka: which settings go together」一致）：
# - 本地 docker-compose：KAFKA_MODE=admin；代码固定 PLAINTEXT，无安全协议类环境变量。勿设 KAFKA_SSL_CA_FILE；KAFKA_AWS_* 可保持注释。
# - APP_ENV=deployed：必须 KAFKA_MODE=aws_msk；代码固定 SASL_SSL+OAUTHBEARER（MSK IAM，无环境变量开关）。配 KAFKA_AWS_REGION、bootstrap（IAM 常见 9098）、AWS 凭证；可选 KAFKA_SSL_CA_FILE。KAFKA_AWS_DEBUG_CREDS 仅排障时临时 true。
# Kafka 集群地址
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Kafka 模式：admin=启动时自动建 topic；aws_msk=使用 IAM 认证且不做 topic 创建，要求 topic 预先存在
KAFKA_MODE=admin
# Topic 名称
KAFKA_TOPIC=AI_STAGING_TRANSCRIPTION
# 新建 Topic 时的分区数（已有 Topic 不受影响）
# 目标是更低尾延迟时可增大分区，降低单分区排队
# 代码默认 50（未设置本变量时）；此处 100 为显式覆盖，与 300/400/500 并发画像一致
KAFKA_TOPIC_NUM_PARTITIONS=100
# 副本因子（本地开发=1，生产≥2）
KAFKA_REPLICATION_FACTOR=1
# 压缩类型：none、gzip、snappy、lz4、zstd
KAFKA_COMPRESSION_TYPE=lz4
# 自定义 Kafka TLS CA 证书链文件路径；仅在 aws_msk 且 broker/NLB 证书不被系统默认信任时启用
# KAFKA_SSL_CA_FILE=/path/to/custom-ca-chain.pem
# 仅 KAFKA_MODE=aws_msk 时需要：取消注释并填写区域；admin 模式下勿依赖此项
# KAFKA_AWS_REGION=ap-east-1
# 仅 aws_msk 且排障时临时 true；生产长期 false 或省略
# KAFKA_AWS_DEBUG_CREDS=false
# 发送超时（秒），Kafka 不可用时快速失败
# 高并发下单机 broker 偶尔慢，5s 比 2s 宽容又不至于拖死连接
KAFKA_SEND_TIMEOUT_SEC=5
# producer 聚合等待（ms）：越小延迟越低、吞吐可能略降
KAFKA_LINGER_MS=1
# producer 批大小（bytes）：中等批次兼顾吞吐与尾延迟
KAFKA_BATCH_SIZE=32768

# =============================================================================
# WebSocket
# =============================================================================
# Uvicorn websockets 后端：服务端主动发 Ping 的间隔 / 等 Pong 超时（秒）
WS_PING_INTERVAL=20.0
WS_PING_TIMEOUT=10.0
# 会话发送所有权后台续租周期（秒）
WS_OWNERSHIP_GUARD_REFRESH_INTERVAL_SEC=5.0

# =============================================================================
# Handshake Authentication
# =============================================================================
# Whether to enforce Authorization: Bearer <JWT> during WebSocket handshake
AUTH_ENABLED=false
# HS256 signing material; required when AUTH_ENABLED=true
AUTH_JWT_SIGNING_MATERIAL=replace-with-signing-material
# Current implementation only supports HS256
AUTH_JWT_ALGORITHM=HS256

# =============================================================================
# HTTP / Uvicorn
# =============================================================================
# 监听地址（容器内通常 0.0.0.0）
HTTP_HOST=0.0.0.0
# 监听端口
HTTP_PORT=8080
# listen backlog，瞬时大量 WS 握手时可酌情调大
HTTP_BACKLOG=4096
# 只有当值为 true 时才暴露 /docs、/redoc、/openapi.json；其余值一律关闭
HTTP_ENABLE_DOCS=false
# 最大同时在线 WS 连接数；超限时握手前返回 HTTP 429 + E1008。0=不限
# 400 并发平衡档建议：480（约目标并发 1.2x，留连接交叠空间）
# 1000 并发容量档可提升到 1200+
WS_MAX_CONNECTIONS=480

# =============================================================================
# 启动检查
# =============================================================================
# Kafka 启动连通性检查超时（秒）
KAFKA_STARTUP_TIMEOUT_SEC=30.0

# =============================================================================
# 其它
# =============================================================================
# 优雅停机超时（秒）
STOP_TIMEOUT=120
# 日志级别：DEBUG、INFO、WARNING、ERROR
# 压测时建议 WARNING 减少 I/O 开销；排查问题时切回 INFO
LOG_LEVEL=WARNING
# 日志格式：json、console、auto（非 TTY 自动用 json）
LOG_FORMAT=auto
# 是否打印服务端发出的 ERROR 响应完整 JSON（排障用；压测时建议关闭）
LOG_WS_ERROR_FRAMES=false
# 慢消息分段耗时 WARNING 阈值（毫秒）；0=关闭
# 开启后会在单条消息总耗时超过阈值时限频输出 decode/validate/prepare/kafka_send/commit/ack/send 分段
LOG_SLOW_MESSAGE_THRESHOLD_MS=0
