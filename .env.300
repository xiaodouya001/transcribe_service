# Transcribe Service 环境变量示例
# 复制为 .env 并修改: cp .env.example .env

# =============================================================================
# Redis（状态机）
# =============================================================================
# Redis 连接地址
REDIS_URL=redis://127.0.0.1:6379/0
# Redis 连接池大小（高并发时调大）
# 每条 WS 消息需 2 次 Redis 往返（prepare + commit），await 期间持有连接。
# 300 并发低延迟档建议：900（覆盖连接占用与抖动）
# 1000 并发容量档可提升到 2000+
# 勿超过 Redis maxclients（默认 10000）
REDIS_MAX_CONNECTIONS=900
# 活跃会话 TTL（秒），每次写入自动续期
REDIS_ACTIVE_TTL_SEC=3600
# SESSION_COMPLETE 后的残留 TTL（秒），兜住迟到包
REDIS_FINAL_TTL_SEC=30
# conversation 发送连接 owner key TTL（秒）
REDIS_OWNERSHIP_GUARD_TTL_SEC=30
# Redis Sequence State Machine key 前缀
REDIS_SEQUENCE_STATE_KEY_PREFIX=transcript:session
# Redis Ownership Guard key 前缀
REDIS_OWNERSHIP_GUARD_KEY_PREFIX=transcript:owner

# =============================================================================
# Kafka
# =============================================================================
# Kafka 集群地址
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Topic 名称
KAFKA_TOPIC=cc.transcript.realtime.v1
# 新建 Topic 时的分区数（已有 Topic 不受影响）
# 目标是更低尾延迟时可增大分区，降低单分区排队
KAFKA_TOPIC_NUM_PARTITIONS=100
# 副本因子（本地开发=1，生产≥2）
KAFKA_REPLICATION_FACTOR=1
# 压缩类型：none、gzip、snappy、lz4、zstd
KAFKA_COMPRESSION_TYPE=lz4
# 发送超时（秒），Kafka 不可用时快速失败
# 高并发下单机 broker 偶尔慢，5s 比 2s 宽容又不至于拖死连接
KAFKA_SEND_TIMEOUT_SEC=5
# producer 聚合等待（ms）：越小延迟越低、吞吐可能略降
KAFKA_LINGER_MS=1
# producer 批大小（bytes）：中等批次兼顾吞吐与尾延迟
KAFKA_BATCH_SIZE=32768

# =============================================================================
# WebSocket
# =============================================================================
# Uvicorn websockets 后端：服务端主动发 Ping 的间隔 / 等 Pong 超时（秒）
WS_PING_INTERVAL=20.0
WS_PING_TIMEOUT=20.0
# 会话发送所有权后台续租周期（秒）
WS_OWNERSHIP_GUARD_REFRESH_INTERVAL_SEC=5.0

# =============================================================================
# HTTP / Uvicorn
# =============================================================================
# 监听地址（容器内通常 0.0.0.0）
HTTP_HOST=0.0.0.0
# 监听端口
HTTP_PORT=8080
# listen backlog，瞬时大量 WS 握手时可酌情调大
HTTP_BACKLOG=4096
# 最大同时在线 WS 连接数；超限时握手前返回 HTTP 429 + E1008。0=不限
# 300 并发低延迟档建议：360（约目标并发 1.2x，留连接交叠空间）
# 1000 并发容量档可提升到 1200+
WS_MAX_CONNECTIONS=360

# =============================================================================
# 启动检查
# =============================================================================
# Kafka 启动连通性检查超时（秒）
KAFKA_STARTUP_TIMEOUT_SEC=30.0

# =============================================================================
# 其它
# =============================================================================
# 优雅停机超时（秒）
STOP_TIMEOUT=120
# 日志级别：DEBUG、INFO、WARNING、ERROR
# 压测时建议 WARNING 减少 I/O 开销；排查问题时切回 INFO
LOG_LEVEL=WARNING
# 日志格式：json、console、auto（非 TTY 自动用 json）
LOG_FORMAT=auto
# 是否打印服务端发出的 ERROR 响应完整 JSON（排障用；压测时建议关闭）
LOG_WS_ERROR_FRAMES=false
